using UnityEngine;

/// <summary>
/// Weapon anchor, a child of the first-person camera.
/// Handles hip / ADS pose, inertia sway, walk bob, breathing, recoil and the IK on/off fade.
/// The hand IK targets and elbow hints are CHILDREN of this object, so hands and gun follow it.
/// Runs after FullBodyFirstPerson (camera) and before TwoBoneArmIK.
/// </summary>
[DefaultExecutionOrder(10010)]
public class WeaponAnchor : MonoBehaviour
{
    [Header("References")]
    public FullBodyFirstPerson look;        // gives yaw / pitch every frame
    public Transform bodyRoot;              // used to measure walking speed
    public TwoBoneArmIK[] arms;             // both arms

    [Header("Pose (local to the camera)")]
    public Vector3 hipPosition = new Vector3(0.18f, -0.18f, 0.45f);
    public Vector3 hipEuler = Vector3.zero;
    public Vector3 adsPosition = new Vector3(0f, -0.07f, 0.30f);
    public Vector3 adsEuler = Vector3.zero;
    public float adsSpeed = 8f;             // higher = faster aim
    public bool aiming;
    [HideInInspector] public float externalAimWeight = -1f;
    public Camera viewCamera;
    public float hipFov=85f, adsFov=63f;
    public bool constrainReach=true;
    [Header("Authored pistol reference (optional)")]
    public Animation targetAnimation;
    public AnimationClip referenceIdle, referenceAttack, referenceMechanismAttack;
    [Range(0f,1f)] public float referenceADSRecoil = .2f;
    float referenceShotUntil, referenceShotStart = -100f;
    Transform[] referenceTargets;
    Vector3 referenceRightPosition;
    Quaternion referenceRightRotation;
    public bool UsesReference => targetAnimation && referenceIdle && referenceAttack;
    public bool PlayReferenceShot()
    {
        if(!UsesReference || !look || !look.shooting || look.shooting.RifleEquipped) return false;
        referenceShotStart=Time.time;
        referenceShotUntil=Time.time+referenceAttack.length;
        look.animator.SetBool("PistolAttacking",true);
        look.animator.SetTrigger("PistolAttack");
        var mechanism=look.shooting.Gun?look.shooting.Gun.GetComponent<Animation>():null;
        if(mechanism && referenceMechanismAttack)mechanism.Play(referenceMechanismAttack.name);
        return true;
    }
    public float CurrentIKWeight => arms!=null && arms.Length>0 && arms[0] ? arms[0].weight : 0f;

    [Header("Weight feel (pistol: keep small)")]
    public float swayAmount = 0.6f;         // degrees of lag per degree of look movement
    public float swayMax = 3f;              // limit per axis, degrees
    public float swayStiffness = 55f;       // lower = heavier, lazier
    public float swayDamping = 9f;          // lower = more overshoot
    public float adsSwayScale = 0.4f;

    [Header("Walk bob / breathing")]
    public float walkSpeed = 4f;            // speed that counts as full bob
    public float bobFrequency = 9f;
    public float bobAmount = 0.004f;        // metres
    public float breathAmount = 0.0008f;

    [Header("Recoil")]
    public float recoilStiffness = 70f;
    public float recoilDamping = 11f;

    [Header("Hands IK")]
    public float ikFadeTime = 0.15f;

    // simple spring (semi-implicit Euler with sub-steps)
    struct Spring
    {
        public Vector3 x, v;
        public void Step(Vector3 target, float k, float c, float dt)
        {
            int n = Mathf.Max(1, Mathf.CeilToInt(dt / 0.008f));
            float h = dt / n;
            for (int i = 0; i < n; i++)
            {
                Vector3 a = k * (target - x) - c * v;
                v += a * h;
                x += v * h;
            }
        }
    }

    Spring sway, recoilPos, recoilRot;
    float adsT, speed01, bobT, lastYaw, lastPitch, ikTarget = 1f;
    Vector3 lastBodyPos, bobCur;
    public int LastPresentedFrame {get;private set;}=-1;

    void Start()
    {
        if (look) { lastYaw = look.Yaw; lastPitch = look.Pitch; }
        if (bodyRoot) lastBodyPos = bodyRoot.position;
        if(UsesReference)
        {
            targetAnimation.Stop();
            targetAnimation.enabled=false;
            referenceTargets=new Transform[transform.childCount];
            for(int i=0;i<referenceTargets.Length;i++)referenceTargets[i]=transform.GetChild(i);
            referenceIdle.SampleAnimation(gameObject,0f);
            referenceRightPosition=arms[0].target.localPosition;
            referenceRightRotation=arms[0].target.localRotation;
        }
    }

    /// <summary>Call when you shoot. Defaults suit a pistol.</summary>
    public void Kick(float back = 0.03f, float upDeg = 2.5f, float sideDeg = 0.6f)
    {
        recoilPos.x += new Vector3(0f, 0f, -back);
        recoilRot.x += new Vector3(-upDeg, Random.Range(-sideDeg, sideDeg), 0f);
    }

    /// <summary>true while a draw / reload animation should drive the hands.</summary>
    public void SetHandsFree(bool free) { ikTarget = free ? 0f : 1f; }
    // Parameterless versions for Animation Events
    public void HandsFree() { ikTarget = 0f; }
    public void HandsLocked() { ikTarget = 1f; }

    void LateUpdate()
    {
        float dt = Time.deltaTime;
        if (dt <= 0f) return;
        if(UsesReference && look && look.animator)
            look.animator.SetBool("PistolAttacking",Time.time<referenceShotUntil && look.shooting && look.shooting.Equipped && !look.shooting.Reloading);

        // ADS
        adsT = externalAimWeight>=0 ? externalAimWeight : Mathf.MoveTowards(adsT, aiming ? 1f : 0f, adsSpeed * dt);
        float adsE = adsT * adsT * (3f - 2f * adsT);
        if(UsesReference && referenceTargets!=null)
        {
            bool firing=Time.time<referenceShotUntil;
            var clip=firing?referenceAttack:referenceIdle;
            clip.SampleAnimation(gameObject,firing?Time.time-referenceShotStart:Mathf.Repeat(Time.time,clip.length));
            if(firing && adsE>0f)
            {
                // Preserve the authored grip as one rigid frame. Full hip-fire kick
                // would push the hands through the eye when the pistol is raised for ADS.
                var right=arms[0].target;
                Vector3 origin=right.localPosition;
                Quaternion rotation=right.localRotation;
                float strength=Mathf.Lerp(1f,referenceADSRecoil,adsE);
                Vector3 adjusted=Vector3.Lerp(referenceRightPosition,origin,strength);
                Quaternion correction=Quaternion.Slerp(referenceRightRotation,rotation,strength)*Quaternion.Inverse(rotation);
                foreach(var target in referenceTargets)
                {
                    target.localPosition=adjusted+correction*(target.localPosition-origin);
                    target.localRotation=correction*target.localRotation;
                }
            }
        }

        // inertia sway: the weapon lags behind the view and overshoots a little
        if (look)
        {
            float dYaw = Mathf.DeltaAngle(lastYaw, look.Yaw);
            float dPitch = look.Pitch - lastPitch;
            lastYaw = look.Yaw; lastPitch = look.Pitch;
            float s = swayAmount * Mathf.Lerp(1f, adsSwayScale, adsE);
            sway.x += new Vector3(-dPitch, -dYaw, -dYaw * 0.4f) * s;
            sway.x = new Vector3(
                Mathf.Clamp(sway.x.x, -swayMax, swayMax),
                Mathf.Clamp(sway.x.y, -swayMax, swayMax),
                Mathf.Clamp(sway.x.z, -swayMax, swayMax));
        }
        sway.Step(Vector3.zero, swayStiffness, swayDamping, dt);

        // walk speed -> bob
        if (bodyRoot)
        {
            Vector3 d = bodyRoot.position - lastBodyPos; d.y = 0f;
            lastBodyPos = bodyRoot.position;
            float spd = d.magnitude / dt;
            speed01 = Mathf.MoveTowards(speed01, Mathf.Clamp01(spd / Mathf.Max(0.01f, walkSpeed)), dt * 6f);
        }
        bobT += dt * bobFrequency * speed01;
        float bobScale = speed01 * (1f - 0.7f * adsE);
        Vector3 bobTarget = new Vector3(Mathf.Sin(bobT) * bobAmount * 0.5f, -Mathf.Abs(Mathf.Sin(bobT)) * bobAmount, 0f) * bobScale;
        bobTarget.y += Mathf.Sin(Time.time * 1.4f) * breathAmount;
        bobCur = Vector3.Lerp(bobCur, bobTarget, 1f - Mathf.Exp(-12f * dt));

        // recoil returns to rest
        recoilPos.Step(Vector3.zero, recoilStiffness, recoilDamping, dt);
        recoilRot.Step(Vector3.zero, recoilStiffness, recoilDamping, dt);

        // apply
        Vector3 basePos = Vector3.Lerp(hipPosition, adsPosition, adsE);
        Quaternion baseRot = Quaternion.Slerp(Quaternion.Euler(hipEuler), Quaternion.Euler(adsEuler), adsE);
        transform.localPosition = basePos + bobCur + recoilPos.x;
        transform.localRotation = baseRot * Quaternion.Euler(sway.x + recoilRot.x);
        if(viewCamera)viewCamera.fieldOfView=Mathf.Lerp(hipFov,adsFov,adsE);

        // IK fade (draw / reload set the hands free)
        if (arms != null)
            foreach (var a in arms)
                if (a) a.weight = Mathf.MoveTowards(a.weight, ikTarget, dt / Mathf.Max(0.01f, ikFadeTime));
        // Move both targets together: never detach the support hand by clamping it alone.
        if(constrainReach && ikTarget>.5f && arms!=null)
            for(int pass=0;pass<6;pass++)foreach(var arm in arms)if(arm&&arm.weight>.95f)transform.position-=arm.ReachExcess();
        LastPresentedFrame=Time.frameCount;
    }
}
